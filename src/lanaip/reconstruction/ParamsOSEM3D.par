OSMAPOSLParameters  :=

objective function type := PoissonLogLikelihoodWithLinearModelForMeanAndProjData
PoissonLogLikelihoodWithLinearModelForMeanAndProjData Parameters := 

input file := iq_s5.hs
maximum absolute segment number to process := 29
zero end planes of segment 0 := 0 
sensitivity filename := sens.hv
recompute sensitivity := 1 
use subset sensitivities := 0

projector pair type := Matrix 
Projector Pair Using Matrix Parameters := 
Matrix type := Ray Tracing 
Ray tracing matrix parameters := 
number of rays in tangential direction to trace for each bin:= 5 
End Ray tracing matrix parameters := 
End Projector Pair Using Matrix Parameters := 

Bin Normalisation type := From ProjData 
Bin Normalisation From ProjData := 
normalisation projdata filename:= corr_norm_last.hs
End Bin Normalisation From ProjData:= 

prior type := FilterRootPrior 
FilterRootPrior Parameters := 
penalisation factor := 0 
Filter type := Median 
Median Filter Parameters := 
mask radius x := 0.5 
mask radius y := 0.5 
mask radius z := 0.5 
End Median Filter Parameters:= 
END FilterRootPrior Parameters := 


zoom := 0.952
xy output image size (in pixels) := 180
Z output image size (in pixels) := 300

end PoissonLogLikelihoodWithLinearModelForMeanAndProjData Parameters := 

number of subsets := 1
number of subiterations := 60
save estimates at subiteration intervals := 5

enforce initial positivity condition:=0 



output filename prefix := iq_lanaip

END := 
